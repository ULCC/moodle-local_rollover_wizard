<?xml version="1.0" encoding="UTF-8" ?>
<XMLDB PATH="local/rollover_wizard/db" VERSION="20240614" COMMENT="XMLDB file for Moodle local/rollover_wizard"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:noNamespaceSchemaLocation="../../../lib/xmldb/xmldb.xsd"
>
  <TABLES>
    <TABLE NAME="local_rollover_wizard_log" COMMENT="Default comment for local_rollover_wizard, please edit me">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="taskid" TYPE="int" LENGTH="20" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="rollovermode" TYPE="char" LENGTH="100" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="instantexecute" TYPE="int" LENGTH="2" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="sourcecourseid" TYPE="int" LENGTH="10" NOTNULL="false" SEQUENCE="false"/>
        <FIELD NAME="targetcourseid" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="templatecourse" TYPE="char" LENGTH="100" NOTNULL="false" SEQUENCE="false"/>
        <FIELD NAME="status" TYPE="char" LENGTH="255" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="userid" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="note" TYPE="text" NOTNULL="false" SEQUENCE="false"/>
        <FIELD NAME="cmids" TYPE="text" NOTNULL="false" SEQUENCE="false"/>
        <FIELD NAME="selectedsections" TYPE="text" NOTNULL="false" SEQUENCE="false"/>
        <FIELD NAME="rolledovercmids" TYPE="text" NOTNULL="false" SEQUENCE="false"/>
        <FIELD NAME="excludedactivitytypes" TYPE="text" NOTNULL="false" SEQUENCE="false"/>
        <FIELD NAME="timecreated" TYPE="int" LENGTH="10" NOTNULL="false" SEQUENCE="false"/>
        <FIELD NAME="timeupdated" TYPE="int" LENGTH="10" NOTNULL="false" SEQUENCE="false"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
      </KEYS>
    </TABLE>
    <TABLE NAME="rollover_wizard_coursesize" COMMENT="Default comment for the table, please edit me">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="courseid" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="size" TYPE="int" LENGTH="20" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="timeupdated" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="timecreated" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
      </KEYS>
    </TABLE>

    <TABLE NAME="local_rollover_wizard_sectionlog" COMMENT="Temporary log for tracking course section summary changes by scheduled task.">
      <FIELDS>
          <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>

          <FIELD NAME="sectionid" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false" COMMENT="ID from course_sections"/>
          
          <FIELD NAME="courseid" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false" COMMENT="Course ID from the section"/>
          
          <FIELD NAME="oldsummary" TYPE="text" NOTNULL="false" SEQUENCE="false" COMMENT="Summary before being updated"/>
          
          <FIELD NAME="newsummary" TYPE="text" NOTNULL="false" SEQUENCE="false" COMMENT="Summary after being updated"/>
          
          <FIELD NAME="timecreated" TYPE="int" LENGTH="20" NOTNULL="true" SEQUENCE="false" COMMENT="Timestamp when the change was logged"/>
      </FIELDS>
      <KEYS>
          <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
      </KEYS>
    </TABLE>
    <TABLE NAME="local_rollover_wizard_processlog" COMMENT="Stores all mtrace output from a rollover process in a single row per task.">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="taskid" TYPE="int" LENGTH="20" NOTNULL="true" SEQUENCE="false" COMMENT="The rollover task ID (0 for scheduled tasks without a single taskid)"/>
        <FIELD NAME="source" TYPE="char" LENGTH="100" NOTNULL="false" SEQUENCE="false" COMMENT="The file or entry point that triggered this process (e.g. rollover_wizard_background.php, execute_rollover task)"/>
        <FIELD NAME="logline" TYPE="text" NOTNULL="false" SEQUENCE="false" COMMENT="Complete mtrace output for this task, appended as the process runs"/>
        <FIELD NAME="timecreated" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false" COMMENT="Timestamp when the first log line was recorded"/>
        <FIELD NAME="timemodified" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false" COMMENT="Timestamp when the log was last updated"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="taskid_idx" UNIQUE="true" FIELDS="taskid" COMMENT="Unique index so each task has exactly one row"/>
      </INDEXES>
    </TABLE>
  </TABLES>
</XMLDB>
